<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    
    <groupId>com.rndmodgames</groupId>
    <artifactId>futtoboru</artifactId>
    <version>0.6.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
	    <module>futtoboru-core</module>
	    <module>futtoboru-desktop</module>
	</modules>

    <profiles>
        <profile>
            <id>development</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>

            </properties>
        </profile>
        <!-- Coverage only on Jenkins (EXECUTOR_BACKUP on WORKSTATION), long integration runs: -Pcoverage (T-02) -->
        <profile>
            <id>coverage</id>
            <properties>
                <jacoco.skip>false</jacoco.skip>
            </properties>
        </profile>
        <!-- T-01 test tiers (D27, docs/BUILD.md "Test tiers"): the default build runs the fast tier only -->
        <profile>
            <!-- ./mvnw -B verify -Pfull: fast + slow (before merging into develop; CI on develop/main and PRs) -->
            <id>full</id>
            <properties>
                <test.excludedGroups>smoke,soak</test.excludedGroups>
            </properties>
        </profile>
        <profile>
            <!-- ./mvnw -B verify -Pslow: the slow tier alone (Jenkins after each develop commit) -->
            <id>slow</id>
            <properties>
                <groups>slow,season</groups>
                <test.excludedGroups>smoke,soak</test.excludedGroups>
            </properties>
        </profile>
        <profile>
            <!-- -Psoak: the nightly soak (D33, INF-01): SoakTests, seeded multi-season games with invariants (Jenkins "Futtoboru Soak") -->
            <id>soak</id>
            <properties>
                <groups>soak</groups>
                <test.excludedGroups>smoke</test.excludedGroups>
            </properties>
        </profile>
        <profile>
            <!-- -Dtest=SomeTests runs that test whatever its tier (a slow test on its own is not skipped) -->
            <id>single-test</id>
            <activation>
                <property>
                    <name>test</name>
                </property>
            </activation>
            <properties>
                <test.excludedGroups></test.excludedGroups>
            </properties>
        </profile>
        <!-- -Psmoke (futtoboru-desktop/pom.xml) adds the smoke tier: the real desktop jar, started for a few seconds -->
    </profiles>
    
    <properties>
        <!-- Project Encoding -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        
    	<!-- junit -->
   		<junit.version>5.4.0</junit.version>
   		
   		<!-- JaCoCo -->
   		<jacoco.version>0.8.10</jacoco.version>
   		<!-- off for local and branch runs; the coverage profile turns it on (T-02) -->
   		<jacoco.skip>true</jacoco.skip>
   		
   		<!-- LibGDX -->
   		<libgdx.version>1.12.0</libgdx.version>
   		
   		<!-- VisUI -->
   		<vis.ui.version>1.5.2</vis.ui.version>
   		
   		<!-- Maven Compiler Plugin -->
   		<maven.compiler.plugin.version>3.11.0</maven.compiler.plugin.version>
   		
   		<!-- Maven Assembly Plugin -->
   		<maven.assembly.plugin.version>3.6.0</maven.assembly.plugin.version>
   		
   		<!-- Maven Jar Plugin -->
   		<maven.jar.plugin.version>3.3.0</maven.jar.plugin.version>
   		
   		<!-- Maven Surefire Plugin -->
   		<maven.surefire.plugin.version>3.1.2</maven.surefire.plugin.version>

   		<!-- T-01 test tiers (D27): JUnit tags left out of the default (fast) run; -Pfull keeps only smoke out -->
   		<test.excludedGroups>slow,season,smoke,soak</test.excludedGroups>
   		
   		<!-- Java Source Version -->
   		<java.source.version>17</java.source.version>
   		
   		<!-- Java Target Version -->
   		<java.target.version>17</java.target.version>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven.surefire.plugin.version}</version>
                    <configuration>
                        <excludedGroups>${test.excludedGroups}</excludedGroups>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven.surefire.plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

	<repositories>
		<repository>
			<id>central</id>
			<url>https://repo1.maven.org/maven2</url>
		</repository>
	</repositories>

    <dependencies>
    
    	<!-- JUnit -->
		<dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        
    </dependencies>
</project>